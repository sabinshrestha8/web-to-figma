# Hosted capture service (apps/server). Copy to .env; never commit real tokens.

# Listen address. Platforms like Cloud Run/Fly/Render set PORT themselves.
PORT=8787
HOST=0.0.0.0

# Captures running at once (each Chromium context can peak at ~200–500 MB) and waiting.
W2F_MAX_RUNNING=2
W2F_MAX_QUEUED=8
# Captures per client per hour (client = access token, else IP address).
W2F_RATE_PER_HOUR=30

# Comma-separated access tokens. Empty = open service (rate limits still apply).
# Hand tokens to users; never build one into the published plugin.
W2F_API_TOKENS=

# 1 = take the client IP from X-Forwarded-For (only behind a proxy you control).
W2F_TRUST_PROXY=0

# How long a finished result stays downloadable, and the largest bundle served.
W2F_RESULT_TTL_MS=600000
W2F_MAX_BUNDLE_MB=60

# 1 = run Chromium with its sandbox (needs a runtime that permits it, e.g. a seccomp profile).
W2F_CHROMIUM_SANDBOX=0

# YOUR OWN MACHINE ONLY: a saved login (pnpm w2f:login / web UI → .data/auth.json) used for every
# capture, so the plugin can import pages behind a login. Requires W2F_API_TOKENS. Never deploy it.
W2F_SESSION=

# DEVELOPMENT ONLY: 1 lets captures reach localhost and private networks. Never set in production.
W2F_ALLOW_PRIVATE=0
